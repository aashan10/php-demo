{
    "name": "example/http",
    "description": "Example HTTP package for demonstration purposes",
    "version": "1.0.0",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "filp/whoops": "^2.15",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src",
            "Elementary\\": "lib/Elementary"
        },
        "files": [
            "src/functions/dd.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html storage/coverage",
        "test-unit": "phpunit --testsuite=\"Unit Tests\"",
        "test-feature": "phpunit --testsuite=\"Feature Tests\""
    }

}

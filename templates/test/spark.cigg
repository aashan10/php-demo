@extends('layouts/guest')

@section('title')
    Spark Test - Elementary Framework
@endsection

@section('content')
    <div class="min-h-screen bg-gray-100 py-12">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold text-gray-900 mb-4">
                    Spark Test Page
                </h1>
                <p class="text-xl text-gray-600">
                    Testing reactive components with Elementary Framework
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- Counter Component -->
                <div>
                    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Counter Component</h2>
                    <div class="flex flex-row gap-6">
                    <ui-spark-counter></ui-spark-counter>
                    <ui-spark-counter></ui-spark-counter>
                    </div>
                </div>

            </div>

            <div class="mt-12 bg-white rounded-lg shadow-lg p-6">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">Event Listener Test</h3>
                <div id="event-log" class="bg-gray-50 rounded p-4 h-32 overflow-y-auto">
                    <p class="text-gray-500">Listening for component events...</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Listen for Spark events
        document.addEventListener('spark:counter-milestone', function(e) {
            const log = document.getElementById('event-log');
            const message = document.createElement('div');
            message.className = 'text-green-600 mb-1';
            message.textContent = `🎉 Counter milestone reached: ${e.detail.count}`;
            log.appendChild(message);
            log.scrollTop = log.scrollHeight;
        });

        document.addEventListener('spark:counter-reset', function(e) {
            const log = document.getElementById('event-log');
            const message = document.createElement('div');
            message.className = 'text-blue-600 mb-1';
            message.textContent = '🔄 Counter was reset';
            log.appendChild(message);
            log.scrollTop = log.scrollHeight;
        });
    </script>
@endsection


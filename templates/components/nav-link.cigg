@php
    $variant = $variant ?? 'default'; // 'default', 'primary', 'danger'
    $href = $href ?? '#';

@endphp

<a href="{{ $href ?? '#' }}" 
   class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 
   {{ 
       $variant === 'primary' ? 'bg-gradient-to-r from-blue-600 to-purple-600 text-white hover:from-blue-700 hover:to-purple-700 transform hover:scale-105 shadow-md hover:shadow-lg' : 
       ($variant === 'danger' ? 'text-red-600 hover:text-red-700 hover:bg-red-50' : 
       'text-gray-700 hover:text-gray-900 hover:bg-gray-100')
   }}">
    @if (isset($icon))
        {!! $icon !!}
    @endif
    {!! $slot !!}
</a>

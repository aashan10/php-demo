                    <h4 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Framework</h4>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-gray-600 hover:text-gray-900 transition-colors">Documentation</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-gray-900 transition-colors">Getting Started</a></li>
